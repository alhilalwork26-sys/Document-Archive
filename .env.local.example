# Project Supabase yang dipakai (bisa project khusus, atau project yang
# sudah ada seperti grccunairdashboard — lihat README.md bagian "Project
# Bersama" untuk cara amannya).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_.
# Used only in src/app/api/**/route.ts, after an explicit admin check.
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
